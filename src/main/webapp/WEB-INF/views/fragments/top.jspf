<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="context-path" content="${pageContext.request.contextPath}">
    <meta name="csrf-token" content="${_csrf.token}">
    <meta name="csrf-header" content="${_csrf.headerName}">

    <title><c:out value="${pageTitle}"/> | SQLFlow</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/sqlflow.css">
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" href="${pageContext.request.contextPath}/">SQLFlow</a>
            <p class="brand-sub">데이터 조회·통제 시스템</p>
            <hr>

            <nav aria-label="업무 메뉴">
                <a class="nav-item ${activeMenu == 'home' ? 'active' : ''}"
                   href="${pageContext.request.contextPath}/"
                   ${activeMenu == 'home' ? 'aria-current="page"' : ''}>
                    <img src="${pageContext.request.contextPath}/icons/House.svg" alt="">업무 현황</a>

                <a class="nav-item ${activeMenu == 'create' ? 'active' : ''}"
                   href="${pageContext.request.contextPath}/requests/new"
                   ${activeMenu == 'create' ? 'aria-current="page"' : ''}>
                    <img src="${pageContext.request.contextPath}/icons/FilePlus.svg" alt="">조회 요청 작성</a>

                <a class="nav-item ${activeMenu == 'requests' ? 'active' : ''}"
                   href="${pageContext.request.contextPath}/requests"
                   ${activeMenu == 'requests' ? 'aria-current="page"' : ''}>
                    <img src="${pageContext.request.contextPath}/icons/Files.svg" alt="">내 조회 요청</a>

                <a class="nav-item ${activeMenu == 'notices' ? 'active' : ''}"
                   href="${pageContext.request.contextPath}/notices"
                   ${activeMenu == 'notices' ? 'aria-current="page"' : ''}>
                    <img src="${pageContext.request.contextPath}/icons/Bell.svg" alt="">공지사항</a>
            </nav>

            <div class="sidebar-foot">
                SELECT 전용<br>허용된 VIEW만 조회
            </div>
        </aside>

        <div class="workspace">
            <header class="header">
                <div class="breadcrumb">
                    <a href="${pageContext.request.contextPath}/">SQLFlow</a>
                    <span>›</span>
                    <c:out value="${pageTitle}"/>
                </div>

                <div class="header-tools">
                    <form class="header-search"
                          action="${pageContext.request.contextPath}/requests"
                          method="get">
                        <label class="sr-only" for="header-keyword">요청 검색</label>
                        <span aria-hidden="true">⌕</span>
                        <input id="header-keyword" name="keyword" placeholder="요청번호, 제목 검색">
                        <button type="submit" class="sr-only">검색</button>
                    </form>

                    <a class="icon-button notification"
                       href="${pageContext.request.contextPath}/notices"
                       aria-label="공지사항">
                        <img src="${pageContext.request.contextPath}/icons/Bell.svg" alt="">
                        <i></i>
                    </a>

                    <a class="help-link" href="${pageContext.request.contextPath}/notices?id=guide">도움말</a>

                    <div class="header-user">
                        <span class="avatar small"><c:out value="${userName.substring(0, 1)}"/></span>
                        <div>
                            <strong><c:out value="${userName}"/> <c:out value="${positionName}"/></strong>
                            <span><c:out value="${deptName}"/></span>
                        </div>
                    </div>
                    <form action="${pageContext.request.contextPath}/logout" method="post">
                        <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
                        <button class="button" type="submit">로그아웃</button>
                    </form>
                </div>
            </header>

            <main class="main">
                <div class="demo-strip">
                    <span>개발 환경</span>로그인 계정 기준으로 요청과 결재 권한을 확인합니다.
                </div>

                <div id="page-message" class="message" role="status" hidden></div>

                <script>
                    'use strict';

                    const BASE = document.querySelector('meta[name="context-path"]').content;
                    const $ = s => document.querySelector(s);

                    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({
                        '&': '&amp;',
                        '<': '&lt;',
                        '>': '&gt;',
                        '"': '&quot;',
                        "'": '&#39;'
                    }[c]));

                    function notify(message, error = false) {
                        const el = $('#page-message');
                        el.textContent = message;
                        el.hidden = false;
                        el.classList.toggle('error', error);
                        el.setAttribute('role', error ? 'alert' : 'status');
                    }

                    async function api(path, options = {}) {
                        const controller = new AbortController(),
                            timer = setTimeout(() => controller.abort(), 15000);

                        try {
                            const response = await fetch(BASE + '/api' + path, {
                                ...options,
                                headers: {
                                    'Accept': 'application/json',
                                    [document.querySelector('meta[name="csrf-header"]')?.content || 'X-CSRF-TOKEN']:
                                        document.querySelector('meta[name="csrf-token"]')?.content || '',
                                    ...(options.body ? {'Content-Type': 'application/json'} : {}),
                                    ...options.headers
                                },
                                signal: controller.signal
                            });
                            
                            // 응답 본문이 없는 정상 처리
							if (response.status === 204) {
							    return null;
							}

                            let data;

                            try {
                                data = await response.json();
                            } catch (e) {
                                throw Error('서버 응답을 확인할 수 없습니다.');
                            }

                            if (!response.ok) throw Error(data.message || '요청 처리 중 오류가 발생했습니다.');

                            return data;
                        } catch (e) {
                            if (e.name === 'AbortError') throw Error('응답 시간이 초과되었습니다. 다시 시도하세요.');
                            throw e;
                        } finally {
                            clearTimeout(timer);
                        }
                    }

                    const post = (path, data) => api(path, {
                        method: 'POST',
                        body: JSON.stringify(data)
                    });

                    async function busy(button, task) {
                        const original = button.textContent;
                        button.disabled = true;
                        button.textContent = '처리 중…';

                        try {
                            return await task();
                        } catch (e) {
                            notify(e.message, true);
                        } finally {
                            button.disabled = false;
                            button.textContent = original;
                        }
                    }

                    const date = s => s
                        ? new Intl.DateTimeFormat('ko-KR', {
                            timeZone: 'Asia/Seoul',
                            year: 'numeric',
                            month: '2-digit',
                            day: '2-digit'
                        }).format(new Date(s))
                        : '-';

                    const typeName = t => t === 'SENSITIVE' ? '민감 조회' : '일반 조회';

                    const stateName = s => ({
                        SUCCESS: '성공',
                        FAILED: '실패',
                        PENDING: '미실행',
                        COMPLETED: '실행 종료',
                        APPROVAL_PENDING: '결재 대기'
                    }[s] || s);

                    function badge(label, kind = 'neutral') {
                        return '<span class="badge ' + kind + '">' + esc(label) + '</span>';
                    }

                    function requestStatus(q) {
                        return badge(
                            stateName(q.state),
                            q.state === 'APPROVAL_PENDING'
                                ? 'waiting'
                                : q.items.some(i => i.state === 'FAILED') ? 'neutral' : 'success'
                        );
                    }

                    function executionSummary(q) {
                        return '성공 ' + q.items.filter(i => i.state === 'SUCCESS').length
                            + ' / 실패 ' + q.items.filter(i => i.state === 'FAILED').length;
                    }

                    function requestRows(rows) {
                        return rows.map(q =>
                            '<tr><td><a class="table-title" href="'
                            + BASE + '/requests/' + encodeURIComponent(q.id) + '">'
                            + esc(q.title) + '</a><span class="secondary">'
                            + esc(q.id) + '</span></td><td>'
                            + esc(typeName(q.type)) + '</td><td>'
                            + requestStatus(q) + '<span class="secondary">'
                            + esc(q.state === 'APPROVAL_PENDING' ? '부서장 결재 진행' : executionSummary(q))
                            + '</span></td><td>' + esc(date(q.createdAt)) + '</td></tr>'
                        ).join('');
                    }

                    function progressHtml(pending) {
                        return '<ol class="approval-steps"><li class="done"><span class="step-dot">✓</span><strong>요청 제출</strong><small>제출 완료</small></li><li class="done"><span class="step-dot">✓</span><strong>중간 결재</strong><small>승인 완료</small></li><li class="'
                            + (pending ? 'current' : 'done')
                            + '"><span class="step-dot">' + (pending ? '3' : '✓')
                            + '</span><strong>부서장 결재</strong><small>'
                            + (pending ? '현재 단계' : '승인 완료')
                            + '</small></li><li class="' + (pending ? '' : 'done')
                            + '"><span class="step-dot">' + (pending ? '4' : '✓')
                            + '</span><strong>자동 실행</strong><small>'
                            + (pending ? '승인 후 진행' : '실행 완료')
                            + '</small></li></ol>';
                    }
                </script>

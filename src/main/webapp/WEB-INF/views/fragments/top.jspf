<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="context-path" content="${pageContext.request.contextPath}">
    <meta name="csrf-token" content="${_csrf.token}">
    <meta name="csrf-header" content="${_csrf.headerName}">

    <title><c:out value="${pageTitle}"/> | SQLFlow</title>

    <link rel="stylesheet"
          href="${pageContext.request.contextPath}/css/sqlflow.css">
    <link rel="stylesheet"
              href="${pageContext.request.contextPath}/css/layout.css?v=20261113-content-top">

    <c:if test="${page == 'home'}">
        <link rel="stylesheet"
              href="${pageContext.request.contextPath}/css/pages/dashboard.css?v=20261113-home-icon">
    </c:if>

    <c:if test="${page == 'my-page'}">
        <link rel="stylesheet"
              href="${pageContext.request.contextPath}/css/pages/my-page.css">
    </c:if>

    <c:if test="${page == 'request-form'
               or page == 'request-review'
               or page == 'request-edit'
               or page == 'request-detail'
               or page == 'requests'
               or page == 'department-requests'
               or page == 'department-request-detail'
               or page == 'view-create-request-form'
               or page == 'approval-pending'
               or page == 'execution-results'
               or page == 'accounts'}">
        <link rel="stylesheet"
              href="${pageContext.request.contextPath}/css/pages/request.css?v=20261113-account-list">
    </c:if>

    <c:if test="${page == 'view-create-request-form'}">
        <link rel="stylesheet" href="${pageContext.request.contextPath}/css/pages/db-change-editor.css?v=20261113-compact-type">
    </c:if>

    <c:if test="${page == 'request-form' or page == 'request-edit'}">
        <link rel="stylesheet"
              href="${pageContext.request.contextPath}/css/pages/request-editor.css?v=20261111-editor-split">
    </c:if>

    <c:if test="${page == 'request-detail' or page == 'department-request-detail'}">
        <script src="${pageContext.request.contextPath}/js/request-sql-download.js?v=20261113-all-sql"></script>
        <link rel="stylesheet"
              href="${pageContext.request.contextPath}/css/pages/request-detail.css?v=20261113-sql-meta">
    </c:if>

    <c:if test="${page == 'request-detail' or page == 'department-request-detail'}">
        <link rel="stylesheet"
              href="${pageContext.request.contextPath}/css/pages/change-sql-result.css?v=20261113-summary">
    </c:if>

    <c:if test="${page == 'request-detail'}">
        <link rel="stylesheet"
              href="${pageContext.request.contextPath}/css/pages/approval-line-modal.css?v=20261111-css-split">
    </c:if>

    <c:if test="${page == 'execution-queue' or page == 'execution-queue-detail'}">
        <link rel="stylesheet"
              href="${pageContext.request.contextPath}/css/pages/execution-queue.css?v=20261113-list-search-fix">
    </c:if>

    <c:if test="${page == 'notices'}">
        <link rel="stylesheet"
              href="${pageContext.request.contextPath}/css/pages/notices.css">
    </c:if>

    <c:if test="${page == 'views'}">
        <link rel="stylesheet"
              href="${pageContext.request.contextPath}/css/pages/views.css">
    </c:if>

    <c:if test="${page == 'views' or page == 'accounts'}">
        <link rel="stylesheet" href="${pageContext.request.contextPath}/css/pages/list-search.css?v=20261113-search">
    </c:if>

    <c:if test="${page == 'db-resource-admin'}">
        <link rel="stylesheet"
              href="${pageContext.request.contextPath}/css/pages/db-resource-admin.css">
    </c:if>

    <c:if test="${page == 'view-detail'}">
        <link rel="stylesheet"
              href="${pageContext.request.contextPath}/css/pages/view-detail.css">
    </c:if>

    <c:if test="${page == 'accounts' or page == 'admin-user-form' or page == 'admin-user-detail'}">
        <script src="${pageContext.request.contextPath}/js/account-roles.js?v=20261113-labels"></script>
    </c:if>

    <c:if test="${page == 'accounts'}">
        <link rel="stylesheet" href="${pageContext.request.contextPath}/css/pages/accounts.css?v=20261113-employee">
    </c:if>

    <c:if test="${page == 'admin-user-form' or page == 'admin-user-detail'}">
        <link rel="stylesheet"
              href="${pageContext.request.contextPath}/css/pages/admin-user.css?v=20261113-center-layout">
    </c:if>

    <c:if test="${page == 'admin-user-detail'}">
        <link rel="stylesheet" href="${pageContext.request.contextPath}/css/pages/account-detail.css?v=20261113-center-layout">
    </c:if>

    <c:if test="${page == 'execution-result-detail'}">
        <link rel="stylesheet"
              href="${pageContext.request.contextPath}/css/pages/execution-result.css?v=20261113-preview-meta-row">
    </c:if>

    <c:if test="${page == 'approval-pending' or page == 'approval-detail'}">
        <link rel="stylesheet"
              href="${pageContext.request.contextPath}/css/pages/approval.css">
    </c:if>
    <c:if test="${page == 'view-detail'
               or page == 'request-detail'
               or page == 'department-request-detail'
               or page == 'execution-result-detail'}">
        <script src="${pageContext.request.contextPath}/js/vendor/sql-formatter.min.js"></script>
        <script src="${pageContext.request.contextPath}/js/sql-display.js?v=20261113-format"></script>
    </c:if>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/pages/list-titles.css?v=20261113-ellipsis">
    <script src="${pageContext.request.contextPath}/js/list-titles.js?v=20261113-ellipsis" defer></script>
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" href="${pageContext.request.contextPath}/">SQLFlow</a>
            <hr>

            <nav aria-label="업무 메뉴">
                <a class="nav-item ${activeMenu == 'home' ? 'active' : ''}"
                   href="${pageContext.request.contextPath}/"
                   ${activeMenu == 'home' ? 'aria-current="page"' : ''}>
                    <img src="${pageContext.request.contextPath}/icons/House.svg" alt="">
                    Home
                </a>

                <details class="nav-group" ${activeMenu == 'create' or activeMenu == 'view-create-requests' or activeMenu == 'views' ? 'open' : ''}>
                    <summary class="nav-item">
					    <img src="${pageContext.request.contextPath}/icons/FilePlus.svg" alt="">
					    데이터 조회·변경
					</summary>
                    <div class="nav-group-links">
                        <a class="nav-item ${activeMenu == 'views' ? 'active' : ''}"
                           href="${pageContext.request.contextPath}/views"
                           ${activeMenu == 'views' ? 'aria-current="page"' : ''}>
                            <img src="${pageContext.request.contextPath}/icons/Files.svg" alt="">
                            뷰 조회
                        </a>
                        <a class="nav-item ${activeMenu == 'create' ? 'active' : ''}"
                           href="${pageContext.request.contextPath}/requests/new"
                           ${activeMenu == 'create' ? 'aria-current="page"' : ''}>
                            <img src="${pageContext.request.contextPath}/icons/FilePlus.svg" alt="">
                            데이터 조회 요청
                        </a>
                        <a class="nav-item ${activeMenu == 'view-create-requests' ? 'active' : ''}"
                           href="${pageContext.request.contextPath}/view-create-requests/new"
                           ${activeMenu == 'view-create-requests' ? 'aria-current="page"' : ''}>
                            <img src="${pageContext.request.contextPath}/icons/FilePlus.svg" alt="">
                            데이터 변경 요청
                        </a>
                    </div>
                </details>

                <details class="nav-group" ${activeMenu == 'requests' or activeMenu == 'department-requests' or activeMenu == 'approvals' ? 'open' : ''}>
                    <summary class="nav-item"><img src="${pageContext.request.contextPath}/icons/Files.svg" alt="">기안·결재</summary>
                    <div class="nav-group-links">
                        <a class="nav-item ${activeMenu == 'requests' ? 'active' : ''}"
                           href="${pageContext.request.contextPath}/requests"
                           ${activeMenu == 'requests' ? 'aria-current="page"' : ''}>
                            <img src="${pageContext.request.contextPath}/icons/Files.svg" alt="">
                            내 요청함
                        </a>
                        <a class="nav-item ${activeMenu == 'department-requests' ? 'active' : ''}"
                           href="${pageContext.request.contextPath}/department-requests"
                           ${activeMenu == 'department-requests' ? 'aria-current="page"' : ''}>
                            <img src="${pageContext.request.contextPath}/icons/Files.svg" alt="">
                            부서 요청함
                        </a>
                        <a class="nav-item ${activeMenu == 'approvals' ? 'active' : ''}"
                           href="${pageContext.request.contextPath}/approvals/pending"
                           ${activeMenu == 'approvals' ? 'aria-current="page"' : ''}>
                            <img src="${pageContext.request.contextPath}/icons/Files.svg" alt="">
                            받은 결재
                        </a>
                    </div>
                </details>

                <a class="nav-item nav-item-emphasis ${activeMenu == 'execution-results' ? 'active' : ''}"
                   href="${pageContext.request.contextPath}/execution-results"
                   ${activeMenu == 'execution-results' ? 'aria-current="page"' : ''}>
                    <img src="${pageContext.request.contextPath}/icons/SquareTerminal.svg" alt="">
                    쿼리 실행 결과
                </a>

                <c:if test="${pageContext.request.isUserInRole('DB_APPROVER') or pageContext.request.isUserInRole('DB_ADMIN') or deptName == 'DB팀'}">
                    <details class="nav-group" ${activeMenu == 'execution-queue' or activeMenu == 'db-resource-admin' ? 'open' : ''}>
                        <summary class="nav-item"><img src="${pageContext.request.contextPath}/icons/SlidersHorizontal.svg" alt="">DB 운영</summary>
                        <div class="nav-group-links">
                            <c:if test="${pageContext.request.isUserInRole('DB_APPROVER')}">
                                <a class="nav-item ${activeMenu == 'execution-queue' ? 'active' : ''}"
                                   href="${pageContext.request.contextPath}/execution-queue"
                                   ${activeMenu == 'execution-queue' ? 'aria-current="page"' : ''}>
                                    <img src="${pageContext.request.contextPath}/icons/SquareTerminal.svg" alt="">
                                    쿼리 실행 대기
                                </a>
                            </c:if>
                            <c:if test="${pageContext.request.isUserInRole('DB_ADMIN') or deptName == 'DB팀'}">
                                <a class="nav-item ${activeMenu == 'db-resource-admin' ? 'active' : ''}"
                                   href="${pageContext.request.contextPath}/db-admin/resources"
                                   ${activeMenu == 'db-resource-admin' ? 'aria-current="page"' : ''}>
                                    <img src="${pageContext.request.contextPath}/icons/SlidersHorizontal.svg" alt="">
                                    리소스·접근 정책 관리
                                </a>
                            </c:if>
                        </div>
                    </details>
                </c:if>

                <a class="nav-item ${(activeMenu == 'accounts' or activeMenu == 'admin-users') ? 'active' : ''}"
                   href="${pageContext.request.contextPath}/accounts"
                   ${(activeMenu == 'accounts' or activeMenu == 'admin-users') ? 'aria-current="page"' : ''}>
                    <img src="${pageContext.request.contextPath}/icons/UserRound.svg" alt="">
                    계정 목록
                </a>
            </nav>

            <nav class="sidebar-secondary" aria-label="공통 메뉴">
                <a class="nav-item ${activeMenu == 'notices' ? 'active' : ''}"
                   href="${pageContext.request.contextPath}/notices"
                   ${activeMenu == 'notices' ? 'aria-current="page"' : ''}>
                    <img src="${pageContext.request.contextPath}/icons/Bell.svg" alt="">
                    공지사항
                </a>
                <a class="nav-item ${activeMenu == 'my-page' ? 'active' : ''}"
                   href="${pageContext.request.contextPath}/my-page"
                   ${activeMenu == 'my-page' ? 'aria-current="page"' : ''}>
                    <img src="${pageContext.request.contextPath}/icons/UserRound.svg" alt="">
                    마이페이지
                </a>
            </nav>

        </aside>

        <div class="workspace">
            <header class="header">
                <nav class="breadcrumb" aria-label="현재 위치">
				    <a href="${pageContext.request.contextPath}/">SQLFlow</a>
				
				    <c:if test="${not empty breadcrumbGroup}">
				        <span aria-hidden="true">›</span>
				        <span><c:out value="${breadcrumbGroup}"/></span>
				    </c:if>
				
				    <c:if test="${not empty breadcrumbMenuPath}">
				        <c:url var="breadcrumbMenuUrl" value="${breadcrumbMenuPath}"/>
				        <span aria-hidden="true">›</span>
				        <a href="${breadcrumbMenuUrl}">
				            <c:out value="${breadcrumbMenuLabel}"/>
				        </a>
				    </c:if>
				
				    <span aria-hidden="true">›</span>
				    <span class="breadcrumb-current" aria-current="page">
				        <c:out value="${empty breadcrumbCurrent ? pageTitle : breadcrumbCurrent}"/>
				    </span>
				</nav>

                <div class="header-tools">
                    <form class="header-search"
                          action="${pageContext.request.contextPath}/requests"
                          method="get">
                        <label class="sr-only" for="header-keyword">내 요청번호·제목 검색</label>
                        <span aria-hidden="true">⌕</span>
                        <input id="header-keyword"
                               name="keyword"
                               placeholder="내 요청번호·제목 검색">
                        <button type="submit" class="sr-only">검색</button>
                    </form>

                    <button id="help-button"
                            class="help-link"
                            type="button"
                            popovertarget="help-popover">
                        도움말
                    </button>

                    <div class="header-user">
                        <span class="avatar small">
                            <c:out value="${userName.substring(0, 1)}"/>
                        </span>
                        <div>
                            <strong>
                                <c:out value="${userName}"/>
                                <c:out value="${positionName}"/>
                            </strong>
                            <span><c:out value="${deptName}"/></span>
                        </div>
                    </div>

                    <form action="${pageContext.request.contextPath}/logout" method="post">
                        <input type="hidden"
                               name="${_csrf.parameterName}"
                               value="${_csrf.token}">
                        <button class="button" type="submit">로그아웃</button>
                    </form>
                </div>
            </header>

            <main class="main">
                <div id="page-message"
                     class="page-toast"
                     role="status"
                     aria-atomic="true"
                     hidden>
                    <div class="page-toast-content">
                        <strong id="page-message-title">알림</strong>
                        <span id="page-message-text"></span>
                    </div>

                    <button id="page-message-close"
                            class="page-toast-close"
                            type="button"
                            aria-label="알림 닫기">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>

                <script>
                    'use strict';

                    const BASE =
                        document.querySelector('meta[name="context-path"]').content;
                    const $ = selector => document.querySelector(selector);

                    const esc = value => String(value ?? '').replace(/[&<>"']/g, char => ({
                        '&': '&amp;',
                        '<': '&lt;',
                        '>': '&gt;',
                        '"': '&quot;',
                        "'": '&#39;'
                    }[char]));

                    let pageMessageTimer = null;

					function closePageMessage() {
					    clearTimeout(pageMessageTimer);
					    pageMessageTimer = null;

					    $('#page-message').hidden = true;
					}

					function notify(message, error = false) {
					    const element = $('#page-message');

					    // 이전 안내의 타이머가 새 오류 알림을 닫지 않도록 초기화한다.
					    clearTimeout(pageMessageTimer);
					    pageMessageTimer = null;

					    element.classList.toggle('is-error', error);
					    element.setAttribute('role', error ? 'alert' : 'status');
					    element.hidden = false;

					    $('#page-message-title').textContent =
					        error ? '확인이 필요합니다' : '알림';

					    $('#page-message-text').textContent =
					        message || '처리 결과를 확인해 주세요.';

					    // 오류는 자동으로 닫지 않는다.
					    if (!error) {
					        pageMessageTimer = setTimeout(function () {
					            // 닫기 버튼에 키보드 포커스가 있으면 자동으로 숨기지 않는다.
					            if (!element.contains(document.activeElement)) {
					                closePageMessage();
					            }
					        }, 5000);
					    }
					}

					$('#page-message-close').addEventListener(
					    'click',
					    closePageMessage
					);

                    async function api(path, options = {}) {
                        const { timeoutMs = 15000, ...fetchOptions } = options;
                        const controller = new AbortController();
                        const timer = setTimeout(
                            () => controller.abort(),
                            timeoutMs
                        );

                        try {
                            const response = await fetch(BASE + '/api' + path, {
                                ...fetchOptions,
                                headers: {
                                    'Accept': 'application/json',
                                    [document.querySelector(
                                        'meta[name="csrf-header"]'
                                    )?.content || 'X-CSRF-TOKEN']:
                                        document.querySelector(
                                            'meta[name="csrf-token"]'
                                        )?.content || '',
                                    ...(options.body
                                        ? {'Content-Type': 'application/json'}
                                        : {}),
                                    ...options.headers
                                },
                                signal: controller.signal
                            });

                            if (response.status === 204) {
                                return null;
                            }

                            let data;

                            try {
                                data = await response.json();
                            } catch (error) {
                                throw Error('서버 응답을 확인할 수 없습니다.');
                            }

                            if (!response.ok) {
                                throw Error(
                                    data.message
                                    || data.detail
                                    || data.title
                                    || '요청 처리 중 오류가 발생했습니다.'
                                );
                            }

                            return data;
                        } catch (error) {
                            if (error.name === 'AbortError') {
                                throw Error('응답 시간이 초과되었습니다. 다시 시도하세요.');
                            }
                            throw error;
                        } finally {
                            clearTimeout(timer);
                        }
                    }

                    const post = (path, data) => api(path, {
                        method: 'POST',
                        body: JSON.stringify(data)
                    });

                    async function busy(button, task) {
                        const originalText = button.textContent;
                        button.disabled = true;
                        button.textContent = '처리 중…';

                        try {
                            return await task();
                        } catch (error) {
                            notify(error.message, true);
                        } finally {
                            button.disabled = false;
                            button.textContent = originalText;
                        }
                    }

                    const date = value => value
                        ? new Intl.DateTimeFormat('ko-KR', {
                            timeZone: 'Asia/Seoul',
                            year: 'numeric',
                            month: '2-digit',
                            day: '2-digit'
                        }).format(new Date(value))
                        : '-';

                    const typeName = type =>
                        type === 'SENSITIVE' ? '민감 조회' : '일반 조회';

                    const stateName = state => ({
                        SUCCESS: '성공',
                        FAILED: '실패',
                        PENDING: '미실행',
                        COMPLETED: '실행 종료',
                        APPROVAL_PENDING: '결재 대기'
                    }[state] || state);

                    function badge(label, kind = 'neutral') {
                        return '<span class="badge ' + kind + '">'
                            + esc(label)
                            + '</span>';
                    }

                    function requestStatus(request) {
                        return badge(
                            stateName(request.state),
                            request.state === 'APPROVAL_PENDING'
                                ? 'waiting'
                                : request.items.some(item => item.state === 'FAILED')
                                    ? 'neutral'
                                    : 'success'
                        );
                    }

                    function executionSummary(request) {
                        return '성공 '
                            + request.items.filter(
                                item => item.state === 'SUCCESS'
                            ).length
                            + ' / 실패 '
                            + request.items.filter(
                                item => item.state === 'FAILED'
                            ).length;
                    }

                    function requestRows(rows) {
                        return rows.map(request =>
                            '<tr><td><a class="table-title" href="'
                            + BASE + '/requests/'
                            + encodeURIComponent(request.id) + '">'
                            + esc(request.title)
                            + '</a><span class="secondary">'
                            + esc(request.id)
                            + '</span></td><td>'
                            + esc(typeName(request.type))
                            + '</td><td>'
                            + requestStatus(request)
                            + '<span class="secondary">'
                            + esc(
                                request.state === 'APPROVAL_PENDING'
                                    ? '부서장 결재 진행'
                                    : executionSummary(request)
                            )
                            + '</span></td><td>'
                            + esc(date(request.createdAt))
                            + '</td></tr>'
                        ).join('');
                    }

                    function progressHtml(pending) {
                        return '<ol class="approval-steps">'
                            + '<li class="done"><span class="step-dot">✓</span>'
                            + '<strong>요청 제출</strong><small>제출 완료</small></li>'
                            + '<li class="done"><span class="step-dot">✓</span>'
                            + '<strong>중간 결재</strong><small>승인 완료</small></li>'
                            + '<li class="' + (pending ? 'current' : 'done') + '">'
                            + '<span class="step-dot">'
                            + (pending ? '3' : '✓')
                            + '</span><strong>부서장 결재</strong><small>'
                            + (pending ? '현재 단계' : '승인 완료')
                            + '</small></li>'
                            + '<li class="' + (pending ? '' : 'done') + '">'
                            + '<span class="step-dot">'
                            + (pending ? '4' : '✓')
                            + '</span><strong>자동 실행</strong><small>'
                            + (pending ? '승인 후 진행' : '실행 완료')
                            + '</small></li></ol>';
                    }
                </script>

<%@ page pageEncoding="UTF-8" %>

<div class="request-detail-layout">

    <section id="request-info" class="panel request-info-panel" hidden>
        <h2>요청 정보</h2>

        <dl class="key-values request-info-grid">
            <div id="source-request-row" class="request-source-row" hidden>
                <dt>원본 요청</dt>
                <dd><a id="source-request-link"></a></dd>
            </div>

            <div>
                <dt>작성자</dt>
                <dd id="drafter-name"></dd>
            </div>

            <div>
                <dt>요청 부서</dt>
                <dd id="dept-name"></dd>
            </div>

            <div>
                <dt>요청 유형</dt>
                <dd id="request-type"></dd>
            </div>

            <div>
                <dt>조회 유형</dt>
                <dd id="request-class"></dd>
            </div>

            <div>
                <dt>결재 상태</dt>
                <dd id="approval-status"></dd>
            </div>

            <div>
                <dt>생성 시각</dt>
                <dd id="created-at"></dd>
            </div>

            <div>
                <dt>제출 시각</dt>
                <dd id="submitted-at"></dd>
            </div>

            <div>
                <dt>긴급 여부</dt>
                <dd>
                    <span id="request-urgency" class="badge"></span>
                </dd>
            </div>

            <div>
                <dt>희망일</dt>
                <dd id="request-desired-date"></dd>
            </div>
        </dl>

        <div class="request-content-section">
            <h2>조회 목적</h2>
            <p id="request-purpose" class="notice-body"></p>
        </div>

        <div class="request-content-section">
            <h2>상세 내용</h2>
            <p id="request-detail-content" class="notice-body"></p>
        </div>
    </section>

    <aside class="panel request-approval-panel"
           aria-labelledby="request-approval-title">

        <div class="panel-heading">
            <h2 id="request-approval-title">결재선</h2>
            <span id="request-approval-badge" class="badge">미등록</span>
        </div>

        <p class="request-approval-description">
            중간 결재자 → 소속 부서장 → DB팀 실행 승인 순서로 진행됩니다.
        </p>

        <ol id="request-approval-list" class="request-approval-list"></ol>

        <c:if test="${not requestDetailReadOnly}">
            <button id="approval-line-open"
                    type="button"
                    class="button primary request-approval-register"
                    aria-haspopup="dialog"
                    aria-controls="approval-line-dialog"
                    aria-describedby="approval-preview-help"
                    disabled>
                결재선 등록
            </button>
        </c:if>

        <p id="approval-preview-help" class="request-approval-help">
            결재선 정보를 불러오는 중입니다.
        </p>
    </aside>
</div>

<section id="approval-history-panel"
         class="panel section-gap approval-history-panel"
         aria-labelledby="approval-history-title"
         hidden>
    <div class="panel-heading">
        <h2 id="approval-history-title">결재 이력</h2>
    </div>

    <ol id="approval-history-list" class="approval-history-list">
        <li class="empty">결재 이력을 불러오는 중입니다.</li>
    </ol>
</section>

<section class="panel section-gap request-sql-panel">
    <div class="panel-heading request-sql-heading">
        <div class="request-sql-heading-main">
            <h2>등록한 SQL</h2>
            <c:if test="${requestDetailReadOnly and deptName == 'DB팀' and pageContext.request.isUserInRole('DB_APPROVER')}">
            <button id="view-sql-download" type="button" class="button primary" hidden>
                승인된 뷰 SQL 다운로드
            </button>
            <span id="view-sql-download-message" class="caption" role="status"></span>
            </c:if>
        </div>
        <span id="sql-count" class="caption request-sql-count"></span>
    </div>

    <c:if test="${not requestDetailReadOnly}">
        <div id="sql-validation-controls"
             class="sql-validation-controls"
             hidden>
            <p class="caption">
                제출 전에 등록한 SQL 전체를 검증해 주세요.
            </p>

            <button id="validate-sqls"
                    type="button"
                    class="button primary">
                전체 SQL 검증
            </button>
        </div>
    </c:if>

    <div id="detail-items">불러오는 중입니다.</div>
</section>

<section id="view-create-result-panel"
         class="panel section-gap"
         aria-labelledby="view-create-result-title"
         hidden>
    <div class="panel-heading">
        <h2 id="view-create-result-title">외부 처리 결과</h2>
        <span id="view-create-result-status" class="badge"></span>
    </div>
    <p id="view-create-result-content" class="notice-body">아직 DB팀 처리 결과가 등록되지 않았습니다.</p>
    <p id="view-create-result-meta" class="caption"></p>

    <form id="view-create-result-form" class="view-create-result-form" hidden>
        <label for="view-create-result-select">처리 상태</label>
        <select id="view-create-result-select" required>
            <option value="COMPLETED">처리 완료</option>
            <option value="FAILED">처리 실패</option>
        </select>

        <label for="view-create-result-input">처리 내용</label>
        <textarea id="view-create-result-input" rows="4" maxlength="4000"
                  placeholder="외부 도구에서 실행한 결과나 실패 사유를 입력하세요." required></textarea>
        <div class="form-footer">
            <span id="view-create-result-message" class="caption" role="status"></span>
            <button id="view-create-result-submit" type="submit" class="button primary">결과 등록</button>
        </div>
    </form>
</section>

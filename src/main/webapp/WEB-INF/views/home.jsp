<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/top.jspf" %>
<div class="page-heading"><h1>업무 대시보드</h1><span id="today" class="muted"></span></div>
<div class="dashboard-grid"><div class="column personal-column">
<section class="panel profile"><div class="profile-avatar"><img src="${pageContext.request.contextPath}/icons/UserRound.svg" alt=""></div><h2><c:out value="${userName}"/></h2><p class="muted"><c:out value="${deptName}"/> · <c:out value="${positionName}"/></p><span class="badge">로그인 사용자</span><div class="my-counts"><div><strong id="total">—</strong><span>전체 요청</span></div><div><strong id="pending">—</strong><span>결재 대기</span></div></div><dl class="key-values"><div><dt>실행 종료</dt><dd id="completed">—</dd></div><div><dt>성공한 SQL</dt><dd id="success-sql">—</dd></div><div><dt>실패한 SQL</dt><dd id="failed-sql">—</dd></div></dl><p class="caption">본인 전체 요청 기준</p></section>
<section class="panel"><h2>조회 가능 데이터</h2><div class="resource"><strong>매출 요약</strong><code>V_SALES_SUMMARY</code><span class="badge">일반 조회</span></div><div class="resource"><strong>계약 상세</strong><code>V_CONTRACT_DETAIL</code><span class="badge waiting">민감 조회</span></div><p class="caption">시연용 영업팀 접근 정책</p></section></div>
<div class="column"><section class="panel"><div class="panel-heading"><h2>업무 바로가기</h2></div><div class="shortcuts"><a href="${pageContext.request.contextPath}/requests/new"><img src="${pageContext.request.contextPath}/icons/Sparkles.svg" alt=""><strong>AI 조회 요청</strong><span>자연어로 SQL 초안 작성</span></a><a href="${pageContext.request.contextPath}/requests/new?mode=direct"><img src="${pageContext.request.contextPath}/icons/SquareTerminal.svg" alt=""><strong>직접 SQL 작성</strong><span>SELECT SQL 입력 및 검증</span></a></div><a class="quick-bottom" href="${pageContext.request.contextPath}/requests"><img src="${pageContext.request.contextPath}/icons/Files.svg" alt="">내 조회 요청 전체 확인 <span>→</span></a></section>
<section class="panel recent"><div class="panel-heading"><h2>최근 조회 요청</h2><a href="${pageContext.request.contextPath}/requests">전체 보기</a></div><div class="table-scroll"><table><thead><tr><th>요청명</th><th>조회 유형</th><th>처리 상태</th><th>요청일</th></tr></thead><tbody id="recent-rows"><tr><td colspan="4" class="empty">불러오는 중입니다.</td></tr></tbody></table></div></section>
<section class="panel"><div class="panel-heading"><h2>내 요청 결재 진행</h2><span class="caption" id="pending-count"></span></div><div id="approval-content" class="empty">불러오는 중입니다.</div></section></div>
<div class="column"><section class="operation-banner"><span class="eyebrow">SQLFLOW · 운영 안내</span><h2>조회 결과 파일<br>보관 기간 안내</h2><p>결과 파일은 생성일로부터 <strong>30일간</strong> 보관됩니다.</p><a class="button" href="${pageContext.request.contextPath}/notices?id=retention">안내 상세 보기 →</a></section><section class="panel"><div class="panel-heading"><h2>공지사항</h2><a href="${pageContext.request.contextPath}/notices">전체 보기</a></div><div id="notice-list" class="notice-list">불러오는 중입니다.</div></section>
<section class="panel"><h2>주요 이용 기준</h2><dl class="key-values"><div><dt>SQL 범위</dt><dd>SELECT 전용</dd></div><div><dt>요청당 SQL</dt><dd>최대 5개</dd></div><div><dt>결과 미리보기</dt><dd>최대 100행</dd></div><div><dt>전체 결과</dt><dd>CSV 다운로드</dd></div></dl><hr><p class="caption">제출 후 SQL 수정 불가</p></section></div></div>
<script>
async function loadDashboard(){try{const d=await api('/dashboard');$('#today').textContent=date(new Date().toISOString())+' · 본인 요청 기준';for(const [id,key,suffix]of [['total','total',''],['pending','pending',''],['completed','completed','건'],['success-sql','successSql','개'],['failed-sql','failedSql','개']])$('#'+id).textContent=d[key]+suffix;$('#recent-rows').innerHTML=requestRows(d.recent);$('#notice-list').innerHTML=d.notices.map(n=>'<a class="notice" href="'+BASE+'/notices?id='+encodeURIComponent(n.id)+'"><span class="notice-kind">'+esc(n.category)+'</span><strong>'+esc(n.title)+'</strong><time>'+esc(n.date)+'</time></a>').join('');const pending=d.recent.find(q=>q.state==='APPROVAL_PENDING');$('#pending-count').textContent='대기 '+d.pending+'건';$('#approval-content').classList.remove('empty');$('#approval-content').innerHTML=pending?'<a class="table-title" href="'+BASE+'/requests/'+encodeURIComponent(pending.id)+'">'+esc(pending.title)+'</a><p class="caption">'+esc(pending.id)+' · 민감 조회</p>'+progressHtml(true)+'<p class="caption">최종 승인 및 실행 직전 검증 후 자동 실행</p>':'<p class="empty">결재 대기 중인 요청이 없습니다.</p>';}catch(e){notify(e.message,true);$('#recent-rows').innerHTML='<tr><td colspan="4" class="empty">현황을 불러오지 못했습니다.</td></tr>';$('#approval-content').textContent='서버 연결을 확인하세요.';}}
loadDashboard();
</script>
<%@ include file="fragments/bottom.jspf" %>

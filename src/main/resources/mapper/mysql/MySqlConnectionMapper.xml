<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sqlflow.mysql.mapper.MySqlConnectionMapper">

    <select id="selectDatabase" resultType="java.lang.String">
        SELECT DATABASE()
    </select>

    <select id="selectCurrentUser" resultType="java.lang.String">
        SELECT CURRENT_USER()
    </select>

    <select id="selectMessage" resultType="java.lang.String">
        SELECT message
        FROM connection_test
        WHERE id = #{id}
    </select>

</mapper>
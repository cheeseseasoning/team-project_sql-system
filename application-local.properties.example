# 사용 방법
# 1. 이 파일을 같은 폴더에 복사합니다.
# 2. 복사한 파일 이름을 application-local.properties로 변경합니다.
# 3. 아래 DB 주소와 비밀번호를 채웁니다.
# 4. STS에서 애플리케이션을 실행합니다.

# DB가 자신의 PC에 있으면 localhost,
# 공용 DB라면 Oracle이 설치된 PC의 IP를 입력합니다.
spring.datasource.url=jdbc:oracle:thin:@//192.168.3.131:1521/XEPDB1
spring.datasource.username=SQLFLOW
spring.datasource.password=

# 조회용 MySQL
app.datasource.query.url=jdbc:mysql://192.168.3.131:3306/sqlflow_demo?sslMode=REQUIRED
app.datasource.query.username=sqlflow_reader
app.datasource.query.password=
app.datasource.query.driver-class-name=com.mysql.cj.jdbc.Driver

# SQL 실행 결과 CSV 공용 저장 폴더
# 공유 PC의 IP와 공유 이름에 맞게 변경
# 예: //192.168.0.10/sqlflow-data/results
# 실행하는 Windows 계정에 공유 폴더 접근 권한과 인증이 필요함
sqlflow.result.storage-root=//<공유-PC-IP>/<공유이름>/results
# SQLFlow 로컬 개발환경 설정
#
# 최초 설정
# 1. 이 파일을 프로젝트 루트(pom.xml과 같은 폴더)에 복사합니다.
# 2. 복사본 이름을 application-local.properties로 변경합니다.
# 3. 아래 Oracle·MySQL 비밀번호를 각각 입력합니다.
# 4. tools의 EC2 DB·CSV 연결 가이드에 따라 연결을 준비합니다.
#
# 개발 시작 순서
# 1. tools/connect-db.bat 실행 — DB 터널 창을 계속 열어 둡니다.
# 2. SSHFS-Win-Manager에서 EC2 CSV 폴더를 Z: 드라이브로 연결합니다.
# 3. STS에서 애플리케이션을 실행합니다.
#
# 복사본 application-local.properties는 개인 설정이므로 Git에 커밋하지 않습니다.
# 설정 변경 후에는 애플리케이션을 재시작합니다.


# Oracle 관리 DB
# 로그인·요청·결재·실행 이력 저장에 사용합니다.
# 내 PC의 11521 → SSH 터널 → EC2의 Oracle 1521
# 여기에 EC2 IP가 아닌 로컬 터널 주소를 지정합니다.
spring.datasource.url=jdbc:oracle:thin:@//127.0.0.1:11521/XEPDB1
spring.datasource.username=SQLFLOW
spring.datasource.password=


# MySQL 조회 DB
# 승인된 SELECT SQL 실행에 사용합니다.
# 내 PC의 13306 → SSH 터널 → EC2의 MySQL 3306
app.datasource.query.url=jdbc:mysql://127.0.0.1:13306/sqlflow_demo?sslMode=REQUIRED
app.datasource.query.username=sqlflow_reader
app.datasource.query.password=
app.datasource.query.driver-class-name=com.mysql.cj.jdbc.Driver


# CSV 결과 저장·조회 경로
# EC2의 아래 폴더를 SSHFS-Win-Manager로 연결합니다.
# /home/ubuntu/sqlflow-deploy/storage/query-results
#
# Z: 최상위가 위 query-results 폴더가 되도록 연결합니다.
# 다른 드라이브 문자를 사용하면 아래 값도 함께 변경합니다.
# 로컬 앱에는 EC2의 Linux 경로를 직접 입력하지 않습니다.
# DB 터널 BAT는 CSV 드라이브를 자동 연결하지 않습니다.
sqlflow.result.storage-root=Z:/